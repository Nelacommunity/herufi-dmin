# Same Supabase project as the website (Settings → API). The anon key is public by design;
# admin powers come from the signed-in account's role, enforced by Row Level Security.
# Never put the service-role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The storefront website. Used for "View in store" links and to refresh the store's cache after edits.
EXPO_PUBLIC_SITE_URL=https://herufi.co.tz

# Cloudflare Turnstile site key (same as the website's NEXT_PUBLIC_TURNSTILE_SITE_KEY). Required once
# Supabase CAPTCHA protection is on. Empty = no check.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Website address the widget runs under; must be a hostname registered for the Turnstile widget.
EXPO_PUBLIC_TURNSTILE_HOST=https://www.herufi.shop
