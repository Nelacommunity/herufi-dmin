{
  "expo": {
    "name": "Herufi Admin",
    "slug": "herufi-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "herufi-admin",
    "userInterfaceStyle": "automatic",
    "description": "Run the Herufi store: orders, products, customers, discounts and shipping.",
    "ios": {
      "bundleIdentifier": "tz.co.herufi.admin",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Herufi Admin uses your photos to upload product and category images.",
        "NSCameraUsageDescription": "Herufi Admin uses the camera to photograph products."
      }
    },
    "android": {
      "package": "tz.co.herufi.admin",
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0E0E0D",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Herufi Admin uses your photos to upload product and category images.",
          "cameraPermission": "Herufi Admin uses the camera to photograph products."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
